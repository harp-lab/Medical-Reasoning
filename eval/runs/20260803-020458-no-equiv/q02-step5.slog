rule (dgene h) <-- (pd_ad d) (edge h "biolink:gene_associated_with_condition" d)

rule (alias h h) <-- (dgene h)
rule (alias h x) <-- (dgene h) (edge h "biolink:same_as" x)
rule (alias h x) <-- (dgene h) (edge x "biolink:same_as" h)
rule (alias h x) <-- (dgene h) (edge h "biolink:close_match" x)
rule (alias h x) <-- (dgene h) (edge x "biolink:close_match" h)

rule (result h x p) <--
  (alias h x)
  (cpred p)
  (tremor t)
  (edge x p t)
