table (edge str str str)
table (pd_set str)
table (ad_set str)
table (tremor_set str)
table (gene_pd str)
table (gene_ad str)
table (tg str str)
table (pd_eq str str)
table (ad_eq str str)
table (result str str str)

rule (pd_set "MONDO:0005180")
rule (pd_set "DOID:14330")
rule (pd_set "UMLS:C0030567")
rule (pd_set "MESH:D010300")
rule (pd_set "NCIT:C26845")
rule (pd_set "ICD9:332")
rule (ad_set "MONDO:0004975")
rule (ad_set "DOID:10652")
rule (ad_set "UMLS:C0002395")
rule (ad_set "MESH:D000544")
rule (ad_set "NCIT:C2866")
rule (ad_set "ICD9:331.0")
rule (ad_set "HP:0002511")
rule (tremor_set "HP:0001337")
rule (tremor_set "NCIT:C38038")
rule (tremor_set "UMLS:C0040822")
rule (tremor_set "UMLS:C0234369")
rule (tremor_set "UMLS:C1527384")
rule (tremor_set "MESH:D014202")

rule (gene_pd g) <-- (pd_set d) (edge g "biolink:gene_associated_with_condition" d)
rule (gene_ad g) <-- (ad_set d) (edge g "biolink:gene_associated_with_condition" d)

rule (tg g "biolink:causes") <-- (tremor_set t) (edge g "biolink:causes" t)
rule (tg g "biolink:contributes_to") <-- (tremor_set t) (edge g "biolink:contributes_to" t)
rule (tg g "biolink:predisposes") <-- (tremor_set t) (edge g "biolink:predisposes" t)
rule (tg g "biolink:affects") <-- (tremor_set t) (edge g "biolink:affects" t)

rule (pd_eq g g) <-- (gene_pd g)
rule (pd_eq g e) <-- (gene_pd g) (edge g "biolink:same_as" e)
rule (pd_eq g e) <-- (gene_pd g) (edge e "biolink:same_as" g)
rule (pd_eq g e) <-- (gene_pd g) (edge g "biolink:close_match" e)
rule (pd_eq g e) <-- (gene_pd g) (edge e "biolink:close_match" g)

rule (ad_eq g g) <-- (gene_ad g)
rule (ad_eq g e) <-- (gene_ad g) (edge g "biolink:same_as" e)
rule (ad_eq g e) <-- (gene_ad g) (edge e "biolink:same_as" g)
rule (ad_eq g e) <-- (gene_ad g) (edge g "biolink:close_match" e)
rule (ad_eq g e) <-- (gene_ad g) (edge e "biolink:close_match" g)

rule (result g "PD" p) <-- (gene_pd g) (pd_eq g e) (tg e p)
rule (result g "AD" p) <-- (gene_ad g) (ad_eq g e) (tg e p)
