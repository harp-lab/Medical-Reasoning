rule (tremor_set "UMLS:C1527384")
rule (tremor_set "MESH:D014202")

rule (dis_gene g "PD") <-- (pd_set d) (edge g "biolink:gene_associated_with_condition" d)
rule (dis_gene g "AD") <-- (ad_set d) (edge g "biolink:gene_associated_with_condition" d)

rule (tremor_gene g) <-- (tremor_set t) (edge g "biolink:causes" t)
rule (tremor_gene g) <-- (tremor_set t) (edge g "biolink:contributes_to" t)
rule (tremor_gene g) <-- (tremor_set t) (edge g "biolink:gene_associated_with_condition" t)

rule (result g name flag) <-- (dis_gene g flag) (tremor_gene g) (node g name _)
rule (result g name flag) <-- (dis_gene g flag) (equiv g e) (tremor_gene e) (node g name _)
