table (edge str str str)
table (equiv str str)
table (pd_gene str)
table (ad_gene str)
table (both str)
table (tremor_id str)
table (tremor_cause str)
table (result str)

rule (tremor_id "HP:0001337")
rule (tremor_id "NCIT:C38038")
rule (tremor_id "UMLS:C0040822")
rule (tremor_id "UMLS:C0234369")
rule (tremor_id "UMLS:C1527384")
rule (tremor_id "MESH:D014202")

rule (both g) <-- (pd_gene g) (ad_gene g)
rule (both g) <-- (pd_gene g) (equiv g e) (ad_gene e)

rule (tremor_cause g) <-- (tremor_id t) (edge g "biolink:causes" t)
rule (tremor_cause g) <-- (tremor_id t) (edge g "biolink:predisposes" t)

rule (result g) <-- (both g) (tremor_cause g)
rule (result g) <-- (both g) (equiv g e) (tremor_cause e)
