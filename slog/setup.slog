table (kg2_edges str str str str str str str str str str str str str str str)
table (kg2_nodes str str str str str str str str str str str str str)
table (kg2_node_synonym str str)
table (kg2_node_publication str str)
table (kg2_norm str str)

table (edge str str str)
table (edge_dir str str str str str)
table (node str str str)
table (edge_rel str str str)

rule (edge s p o) <--
  (kg2_edges p _ "False" _ _ _ _ _ _ _ _ _ _ s o)

rule (edge_dir s p o asp dir) <--
  (kg2_edges p _ "False" _ _ asp dir _ _ _ _ _ _ s o)

rule (edge_rel s ptype o) <--
  (kg2_edges _ _ "False" _ _ _ _ _ _ _ _ _ ptype s o)

rule (node id nm cat) <--
  (kg2_nodes _ _ _ _ _ _ id _ _ nm _ _ cat)

;; ---------------------------------------------------------------------------
;; Below this point setup.slog is GENERATED.  Edit setup.head.slog, then rerun
;; `python preprocess/build_signed_edges.py` -- it concatenates this file with
;; generated/node_kinds.slog and generated/signed_edges.slog into setup.slog.

;; GENERATED by preprocess/build_signed_edges.py -- do not edit.
;;
;; node_kind(id, kind) -- KG2 categories are flat and single-valued, so a query
;; filtering on "biolink:Gene" alone misses the Protein and Polypeptide nodes that
;; carry most drug-target edges.  Filter on kind instead.
;;
;; Deliberately a MULTI-MAP: biolink:DiseaseOrPhenotypicFeature is both disease and
;; phenotype.

table (node_kind str str)

rule (node_kind id "gene") <-- (node id _ "biolink:Gene")
