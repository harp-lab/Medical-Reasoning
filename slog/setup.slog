;; GENERATED by preprocess/build_signed_edges.py -- do not edit.
;;
;; signed_edge(subject, sign, object, predicate_type, mode)
;;
;; sign is +1 if increasing the subject increases the object, -1 if it decreases it,
;; and 0 if the source relationship states NO direction at all.
;;
;; The 0 rows are here on purpose.  Zero is absorbing under multiplication, so a chain
;; through one gives product 0 and is rejected by `(= prod -1)` -- a fully locked query
;; cannot be contaminated by them.  Keeping them means a PARTIALLY locked question
;; ("hops 1-2 directed, hop 3 unknown") stays in one relation with its mode and source
;; intact.  If you use a 0 edge, the direction of that hop is unknown and the answer must
;; say so.  mode="association" marks the ones that are undirected by nature
;; (gene_associated_with_condition, related_to, physically_interacts_with): those are
;; sign-SYMMETRIC, so a 0 is a statement that no direction exists, not a missing value.
;;
;; Rows are in CANONICAL orientation: inverse-named source predicates are already
;; flipped or dropped, so no query ever writes an orientation rule.
;;
;; Derived from edge_rel, which already filters negated="False".

table (signed_edge str int str str str)

rule (signed_edge s 0 o "biolink:gene_associated_with_condition" "association") <-- (edge_rel s "biolink:gene_associated_with_condition" o)
rule (signed_edge s 0 o "biolink:physically_interacts_with" "association") <-- (edge_rel s "biolink:physically_interacts_with" o)
