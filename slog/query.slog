table (kg2_norm str str)
table (node_kind str str)
table (signed_edge str int str str str)
table (result str str)

rule (result dk m3) <--
  (signed_edge d1 s1 x1 pt1 "regulation")
  (= lit (shas pt1 "SEMMEDDB"))
  (= lit 0)
  (node_kind d1 "chemical")
  (node_kind x1 "gene")
  (kg2_norm x1 g)
  (kg2_norm x2 g)
  (node_kind x2 "gene")
  (signed_edge x2 s2 p1 _ "causation")
  (node_kind p1 "phenotype")
  (kg2_norm p1 pk)
  (kg2_norm p2 pk)
  (node_kind p2 "phenotype")
  (signed_edge p2 s3 y1 _ m3)
  (node_kind y1 "disease")
  (kg2_norm y1 "MONDO:0005180")
  (kg2_norm d1 dk)
  (= prod (* s1 (* s2 s3)))
  (= prod -1)

