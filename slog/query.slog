;; Medically approved drugs that treat Parkinson disease
;; anchor: MONDO:0005180 expansion, inlined as literals (one stage)
;; "medically approved" -> node category "biolink:Drug"

table (edge str str str)
table (node str str str)
table (result str str)

rule (result d name) <-- (edge d "biolink:treats" "MONDO:0005180") (node d name "biolink:Drug")
rule (result d name) <-- (edge d "biolink:treats" "DOID:14330")    (node d name "biolink:Drug")
rule (result d name) <-- (edge d "biolink:treats" "UMLS:C0030567") (node d name "biolink:Drug")
rule (result d name) <-- (edge d "biolink:treats" "MESH:D010300")  (node d name "biolink:Drug")
rule (result d name) <-- (edge d "biolink:treats" "NCIT:C26845")   (node d name "biolink:Drug")
rule (result d name) <-- (edge d "biolink:treats" "ICD9:332")      (node d name "biolink:Drug")
