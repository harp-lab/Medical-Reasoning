;; What drugs treat Parkinson disease?
;; Anchor: MONDO:0005180 expanded to its KG2 id set (6 ids, inlined as one stage).

table (edge str str str)
table (node str str str)
table (result str str str)

rule (result d name cat) <-- (edge d "biolink:treats" "MONDO:0005180") (node d name cat)
rule (result d name cat) <-- (edge d "biolink:treats" "DOID:14330")    (node d name cat)
rule (result d name cat) <-- (edge d "biolink:treats" "UMLS:C0030567") (node d name cat)
rule (result d name cat) <-- (edge d "biolink:treats" "MESH:D010300")  (node d name cat)
rule (result d name cat) <-- (edge d "biolink:treats" "NCIT:C26845")   (node d name cat)
rule (result d name cat) <-- (edge d "biolink:treats" "ICD9:332")      (node d name cat)
