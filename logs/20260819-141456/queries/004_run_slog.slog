;; Which biolink:SmallMolecule or biolink:Drug entities treat Parkinson disease?
;;
;; Anchor: MONDO:0005180 ("Parkinson disease", the plain sense), expanded by
;; expand_entity to its 6 KG2 ids, kept as the membership relation `pd_set`.
;;
;; Two categories are wanted, so `cat_set` holds them as a membership relation
;; too and the single rule joins against it -- one rule, one stage, instead of
;; two near-duplicate rules.

table (edge str str str)
table (node str str str)
table (pd_set str)
table (cat_set str)
table (result str str str)

rule (pd_set "MONDO:0005180")
rule (pd_set "DOID:14330")
rule (pd_set "UMLS:C0030567")
rule (pd_set "MESH:D010300")
rule (pd_set "NCIT:C26845")
rule (pd_set "ICD9:332")

rule (cat_set "biolink:SmallMolecule")
rule (cat_set "biolink:Drug")

rule (result drug name cat) <--
  (pd_set d)
  (edge drug "biolink:treats" d)
  (node drug name cat)
  (cat_set cat)
