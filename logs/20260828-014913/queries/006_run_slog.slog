  (kg2_edges "biolink:treats" "infores:repodb" "False" _ _ _ _ _ _ _ _ _ _ d "UMLS:C0030567")
  (node d nm cat)

rule (result "infores:repodb" d nm cat) <--
  (kg2_edges "biolink:treats" "infores:repodb" "False" _ _ _ _ _ _ _ _ _ _ d "MESH:D010300")
  (node d nm cat)

